{
  "name": "attendance-hub-assets",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./static_src/input.css -o ./attendance/static/attendance/tailwind.css --minify",
    "build:htmx": "cp node_modules/htmx.org/dist/htmx.min.js attendance/static/attendance/htmx.min.js",
    "build": "npm run build:css && npm run build:htmx"
  },
  "devDependencies": { "tailwindcss": "3.4.17", "htmx.org": "2.0.4" }
}

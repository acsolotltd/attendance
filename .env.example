# cp .env.example .env  and edit. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Domain(s) AND the server's public IP: ADMS devices call by IP, so it arrives as the Host header.
DJANGO_ALLOWED_HOSTS=hr.example.com,203.0.113.10
# Time zone your devices are set to (used for "Absent" detection), e.g. Europe/Berlin
DJANGO_TIME_ZONE=UTC

# UI served over HTTPS (e.g. behind Caddy/nginx): turn these on
# DJANGO_HTTPS=1
# DJANGO_BEHIND_PROXY=1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://hr.example.com
# DJANGO_HSTS_SECONDS=31536000

# ADMS receiver
# ADMS_AUTO_REGISTER=0            # keep 0: register devices from the UI box instead
# ADMS_ALLOWED_NETWORKS=203.0.113.0/24,198.51.100.7   # only accept device traffic from these addresses
# ADMS_RATE_LIMIT_PER_MIN=600
# ADMS_TRANS_FLAG=                # force an upload profile for every device (normally set per device)

# WEB_CONCURRENCY=2
# DJANGO_DEBUG=1                  # local development only
